#frame { align-items:center; justify-content:center; }
#card { width:1160px; padding:42px 56px; background-color:rgba(20,19,24,0.95); border-radius:25px; }
#title { font-size:48px; margin-bottom:20px; }
#summary { font-size:32px; margin-bottom:24px; }
#body { max-height:500px; }
#actions { flex-direction:row; justify-content:center; margin-top:32px; }
.service-row { flex-direction:row; align-items:center; margin-bottom:12px; }
.service-row > Label { flex-grow:1; font-size:30px; -unity-text-align:middle-left; }
.service-action { height:76px; min-width:156px; margin:7px 16px; }
