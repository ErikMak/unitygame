#time { position:absolute; left:1107px; top:25px; width:427px; height:95px;  }
#time-value { position:absolute; left:11px; top:12px; width:324px; height:72px; background-color:#2b2e3a; border-radius:15px; font-size:32px; }
#time-icon-tile { position:absolute; left:345px; top:12px; width:72px; height:72px; background-color:#2b2e3a; border-radius:15px; }
#sun-icon { position:absolute; left:356px; top:23px; width:50px; height:50px;  }
#relations { position:absolute; left:1558px; top:25px; width:95px; height:95px;  }
#inventory { position:absolute; left:1677px; top:25px; width:95px; height:95px;  }
#leave { position:absolute; left:1677px; top:25px; width:95px; height:95px;  }
#menu { position:absolute; left:1796px; top:25px; width:95px; height:95px;  }
#location { position:absolute; left:612px; top:956px; width:696px; height:95px; font-size:32px; }
#details { position:absolute; left:612px; top:650px; width:696px; height:284px; display:none; padding:22px 28px; justify-content:center; }
#confirm { position:absolute; left:0px; top:0px; width:1920px; height:1080px; display:none; background-color:rgba(0,0,0,0.6); }
#dialog-box { position:absolute; left:490px; top:320px; width:940px; height:440px;  }
#message { position:absolute; left:52px; top:45px; width:836px; height:194px; font-size:36px; }
#cancel { position:absolute; left:102px; top:289px; width:310px; height:80px;  }
#quit { position:absolute; left:459px; top:289px; width:400px; height:80px;  }
#frame.city #time { left:988px; }
#frame.city #relations { left:1439px; }
#frame.city #inventory { left:1558px; }
#frame.journey #leave { display:none; }
.hud-tile { background-color:rgba(20,19,24,0.95); border-radius:20px; }
.icon-button { align-items:center; justify-content:center; padding:0; }
.icon-button > VisualElement { flex-shrink:0; -unity-background-scale-mode:scale-to-fit; }
#relations-icon { width:39px; height:41px; }
#inventory-icon { width:40px; height:40px; }
#leave-icon { width:80px; height:80px; }
#menu-icon { width:70px; height:70px; }
#summary, #status { font-size:32px; }
#city-actions { flex-direction:row; flex-wrap:wrap; justify-content:space-around; }
.city-action { margin:6px; width:290px; height:60px; border-width:2px; border-color:#78787f; border-radius:14px; }