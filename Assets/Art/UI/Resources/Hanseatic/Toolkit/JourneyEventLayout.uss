#intro { position:absolute; left:0px; top:0px; width:1920px; height:1080px;  }
#choices { position:absolute; left:0px; top:0px; width:1920px; height:1080px;  }
#result { position:absolute; left:0px; top:0px; width:1920px; height:1080px;  }
#intro-back { position:absolute; left:0px; top:0px; width:1920px; height:1080px;  }
#choice-back { position:absolute; left:0px; top:0px; width:1920px; height:1080px;  }
#event-image { position:absolute; left:288px; top:74px; width:1328px; height:711px; -unity-background-scale-mode:scale-to-fit; }
#accept { position:absolute; left:927px; top:894px; width:78px; height:78px; border-radius:39px; background-color:#d9d9d9; color:#141318; font-size:44px; }
#answers { position:absolute; left:594px; top:478px; width:732px; height:500px; justify-content:space-between; }
