#finish { position:absolute; left:692px; top:636px; width:532px; height:94px; border-width:4px; border-color:#de6140; border-radius:36px; font-size:36px; }
#portrait { position:absolute; left:274px; top:132px; width:471px; height:628px; -unity-background-scale-mode:scale-to-fit; }
#dialog-panel { position:absolute; left:163px; top:561px; width:1619px; height:501px;  }
#speaker { position:absolute; left:243px; top:655px; width:415px; height:66px; font-size:36px; }
#dialog-text { position:absolute; left:374px; top:757px; width:1180px; height:157px; font-size:36px; color:black; }
#cinema-top { position:absolute; left:0px; top:0px; width:1920px; height:100px; background-color:black; }
#cinema-bottom { position:absolute; left:0px; top:980px; width:1920px; height:100px; background-color:black; }
#intro-left { position:absolute; left:112px; top:655px; width:178px; height:352px;  }
#intro-right { position:absolute; left:1643px; top:655px; width:178px; height:352px; scale:-1 1; }
#intro-banner { position:absolute; left:247px; top:674px; width:1438px; height:333px; background-color:rgba(20,19,24,0.95); border-top-width:1px; border-bottom-width:1px; border-color:#d9d9d9; }
#intro-text { position:absolute; left:367px; top:703px; width:1198px; height:191px; font-size:36px; }
#intro-line { position:absolute; left:342px; top:935px; width:1235px; height:1px; background-color:rgba(255,255,255,0.65); }
#choice-left { position:absolute; left:112px; top:92px; width:178px; height:352px;  }
#choice-right { position:absolute; left:1643px; top:92px; width:178px; height:352px; scale:-1 1; }
#choice-banner { position:absolute; left:247px; top:111px; width:1438px; height:333px; background-color:rgba(20,19,24,0.95); border-top-width:1px; border-bottom-width:1px; border-color:#d9d9d9; }
#choice-text { position:absolute; left:367px; top:140px; width:1198px; height:191px; font-size:36px; }
#choice-line { position:absolute; left:342px; top:372px; width:1235px; height:1px; background-color:rgba(255,255,255,0.65); }
#result { background-color:rgba(0,0,0,0.6); }
.answer { flex-grow:1; margin-bottom:9px; padding:6px 24px; border-left-width:2px; border-right-width:2px; border-color:#78787f; }
.answer:focus, .answer:hover { border-color:#de6140; }
.dialogue #answers { left:1188px; top:121px; height:490px; }
.dialogue #choice-left, .dialogue #choice-right, .dialogue #choice-banner,
.dialogue #choice-text, .dialogue #choice-line { display:none; }
#choices.journey #portrait, #choices.journey #dialog-panel,
#choices.journey #speaker, #choices.journey #dialog-text,
#choices.journey #cinema-top, #choices.journey #cinema-bottom { display:none; }.answer-status-icon { position:absolute; left:20px; top:35%; width:40px; height:40px; }
#accept-icon { width:50px; height:50px; align-self:center; } #accept { justify-content:center; }
.answer { margin-bottom:13.7px; border-width:0; padding:14px 72px; background-color:rgba(20,19,24,0.9); }
.answer-border { position:absolute; top:14px; bottom:14px; width:2px; background-color:#78787f; }
.answer-border-left { left:14px; }
.answer-border-right { right:14px; }
.answer:hover > .answer-border, .answer:focus > .answer-border { background-color:#de6140; }
